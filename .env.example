# ===========================================================================
# AuctionNow Local Development Environment Configuration
# Copy this file to .env and populate credentials before starting local stack.
# ===========================================================================

# --- Platform Environment Mode ---
# Options: local, stage, prod
AUCTIONNOW_ENV=local
AUCTIONNOW_BASE_URL=http://127.0.0.1:8000

# --- Database Connections ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auctionnow_dev

# --- Authentication & JWT Security ---
JWT_SECRET_KEY=replace_with_64_character_hex_string_for_local_jwt_signing
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- OTP Gateway Configuration ---
SMS_GATEWAY_PROVIDER=mock
SMS_GATEWAY_API_KEY=mock_key_for_local_dev

# --- Stage Environment Credentials (HTTP Basic Auth for FastAPI Cloud) ---
STAGE_USERNAME=auctionnow_stage_user
STAGE_PASSWORD=replace_with_stage_http_basic_password

# --- Deterministic Seed Tokens for Unit Testing ---
TEST_BUYER_TOKEN=stub_buyer_token_for_local_pytest
TEST_SELLER_TOKEN=stub_verified_seller_token_for_local_pytest
TEST_UNVERIFIED_SELLER_TOKEN=stub_unverified_seller_token_for_local_pytest
TEST_ADMIN_TOKEN=stub_admin_token_for_local_pytest

# --- AI Agent Credentials (Optional for local agent execution) ---
OPENAI_API_KEY=sk-proj-yourOpenAiKeyHere
